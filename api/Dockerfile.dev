FROM node:22-alpine
RUN corepack enable

WORKDIR /app

# Install deps using workspace-aware lockfile
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY api/package.json ./api/
RUN pnpm install --filter @eso/api --frozen-lockfile

# Copy source and config (overridden by bind mount in compose)
COPY api/tsconfig.json ./api/
COPY api/src ./api/src

EXPOSE 3001
CMD ["pnpm", "--filter", "@eso/api", "dev"]
